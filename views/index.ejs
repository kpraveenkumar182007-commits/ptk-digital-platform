:root {
  --ptk-red: #A8202B;
  --ptk-yellow: #F2C744;
  --ptk-green: #16734B;
  --ptk-dark: #1a1f2a;
  --ptk-surface: #f5f7f6;
  --ptk-text: #1b1b1b;
  --ptk-muted: #656565;
  --ptk-white: #ffffff;
  --ptk-shadow: 0 18px 34px rgba(17, 24, 39, 0.08);
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #f6f6f2;
  color: var(--ptk-text);
  line-height: 1.6;
}

img { max-width: 100%; }

a { color: var(--ptk-green); text-decoration: none; }

a:hover { text-decoration: underline; }

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

header.site-header {
  background: rgba(19, 31, 29, 0.94);
  color: white;
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(8px);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--ptk-red), var(--ptk-yellow), var(--ptk-green));
  font-size: 1.15rem;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.nav a {
  color: white;
  opacity: 0.9;
  font-size: 0.95rem;
}

.hero {
  background: linear-gradient(rgba(10, 12, 18, 0.55), rgba(10, 12, 18, 0.45)), url('https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
  color: white;
  padding: 90px 0 60px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 0.9fr;
  gap: 40px;
  align-items: center;
}

.hero h1 {
  margin: 0 0 18px;
  font-size: clamp(2.5rem, 5vw, 4rem);
  line-height: 1.1;
}

.hero p {
  font-size: 1.08rem;
  max-width: 620px;
  color: rgba(255,255,255,0.9);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.82rem 1.2rem;
  border-radius: 999px;
  border: 1px solid transparent;
  cursor: pointer;
  font-weight: 600;
  transition: 0.2s ease;
}

.btn-primary {
  background: var(--ptk-red);
  color: white;
}

.btn-primary:hover { filter: brightness(1.05); }

.btn-secondary {
  background: white;
  color: var(--ptk-dark);
}

.card-panel {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 24px;
  padding: 24px;
  box-shadow: var(--ptk-shadow);
}

.stat-strip {
  margin-top: 30px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.stat-box {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px;
  padding: 25px 20px;
  text-align: center;
}

.stat-box strong {
  display: block;
  font-size: 2rem;
  margin-bottom: 4px;
}

.section {
  padding: 76px 0;
}

.section-header {
  margin-bottom: 26px;
}

.eyebrow {
  color: var(--ptk-red);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.8rem;
}

.section-header h2 {
  margin: 8px 0 0;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.15;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.card {
  background: white;
  border-radius: 22px;
  padding: 24px;
  box-shadow: var(--ptk-shadow);
  border: 1px solid rgba(0,0,0,0.04);
}

.value-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  margin-bottom: 16px;
  background: linear-gradient(135deg, rgba(168,32,43,0.1), rgba(22,115,75,0.1));
  font-size: 1.4rem;
}

.list-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
}

.article-card {
  background: white;
  border-radius: 18px;
  padding: 22px;
  box-shadow: var(--ptk-shadow);
}

.meta {
  color: var(--ptk-muted);
  font-size: 0.9rem;
  margin-top: 10px;
}

.form-shell {
  background: white;
  border-radius: 24px;
  padding: 28px;
  box-shadow: var(--ptk-shadow);
}

.form-row {
  display: grid;
  gap: 18px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

label {
  display: block;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--ptk-dark);
  margin-bottom: 8px;
}

input, textarea, select, button {
  font: inherit;
}

input, textarea, select {
  width: 100%;
  border: 1px solid #dfe4e7;
  border-radius: 12px;
  padding: 0.9rem 1rem;
  background: #fbfcfd;
}

textarea {
  min-height: 120px;
  resize: vertical;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}

.checkbox-row input {
  width: 18px;
  height: 18px;
}

.notice {
  border-radius: 16px;
  padding: 1rem 1.1rem;
  margin-bottom: 1rem;
  font-weight: 600;
}

.notice.error {
  background: rgba(168, 32, 43, 0.08);
  color: var(--ptk-red);
}

.notice.success {
  background: rgba(22, 115, 75, 0.08);
  color: var(--ptk-green);
}

.site-footer {
  background: #0f1717;
  color: white;
  padding: 42px 0 18px;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.footer-grid h4 {
  margin-top: 0;
  margin-bottom: 16px;
}

.footer-grid ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
  color: rgba(255,255,255,0.8);
}

.admin-shell {
  padding: 56px 0 80px;
}

.admin-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
}

.admin-sidebar {
  background: white;
  border-radius: 20px;
  padding: 22px 18px;
  box-shadow: var(--ptk-shadow);
  height: fit-content;
}

.admin-sidebar nav {
  display: grid;
  gap: 10px;
}

.admin-sidebar a {
  display: block;
  padding: 0.7rem 0.9rem;
  border-radius: 10px;
  color: var(--ptk-dark);
  background: #f5f7f6;
}

.admin-sidebar a:hover {
  background: #edf3ee;
  text-decoration: none;
}

.dashboard-panels {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.dashboard-panel {
  background: white;
  border-radius: 18px;
  padding: 20px;
  box-shadow: var(--ptk-shadow);
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 16px;
  background: white;
  border-radius: 14px;
  overflow: hidden;
}

th, td {
  text-align: left;
  padding: 12px 14px;
  border-bottom: 1px solid #edf1f4;
  vertical-align: top;
}

th {
  background: #f7f8f8;
}

.ptk-membership-card {
  width: 100%;
  max-width: 440px;
  min-height: 250px;
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: linear-gradient(
    to bottom,
    var(--card-red, #A8202B) 0%,
    var(--card-red, #A8202B) 33.333%,
    var(--card-yellow, #F2C744) 33.333%,
    var(--card-yellow, #F2C744) 66.666%,
    var(--card-green, #16734B) 66.666%,
    var(--card-green, #16734B) 100%
  );
  box-shadow: var(--ptk-shadow);
  color: #fff;
  border: 4px solid rgba(255,255,255,0.25);
}

@media print {
  .ptk-membership-card {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}

.card-inner {
  position: relative;
  z-index: 2;
  padding: 26px 18px 16px;
  background: rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.card-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  font-size: 0.82rem;
}

.card-body {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 16px;
  padding: 14px;
  backdrop-filter: blur(2px);
}

.card-photo {
  width: 82px;
  height: 82px;
  border-radius: 12px;
  object-fit: cover;
  border: 2px solid rgba(255,255,255,0.7);
}

.card-metadata {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
  margin-top: 12px;
  font-size: 0.82rem;
}

.card-meta-label {
  opacity: 0.8;
}

.card-footer {
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  font-size: 0.75rem;
}

.qr-box {
  width: 90px;
  height: 90px;
  background: white;
  border-radius: 10px;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.verify-box {
  margin-top: 30px;
  background: white;
  border-radius: 20px;
  padding: 28px;
  box-shadow: var(--ptk-shadow);
}

@media (max-width: 900px) {
  .hero-grid, .list-grid, .admin-grid, .grid-3, .footer-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .dashboard-panels {
    grid-template-columns: 1fr;
  }

  .nav {
    display: none;
  }
}
