<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Volunteers | PTK</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container topbar">
        <div class="brand">
          <div class="brand-mark">PTK</div>
          <div>
            <div><%= settings.party_name_tamil %></div>
            <small><%= settings.party_name_english %></small>
          </div>
        </div>
        <nav class="nav">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/logout">Logout</a>
        </nav>
      </div>
    </header>

    <main class="admin-shell">
      <div class="container" style="max-width: 1060px;">
        <div class="section-header">
          <div class="eyebrow">Volunteers</div>
          <h2>Volunteer registration submissions</h2>
        </div>

        <div class="dashboard-panel">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Reference</th>
                  <th>Name</th>
                  <th>Phone</th>
                  <th>District</th>
                  <th>Interest</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% volunteers.forEach((vol) => { %>
                  <tr>
                    <td><%= vol.ref %></td>
                    <td><%= vol.full_name %></td>
                    <td><%= vol.phone %></td>
                    <td><%= vol.district || 'N/A' %></td>
                    <td><%= vol.interest %></td>
                    <td><%= vol.status %></td>
                    <td><%= formatDate(vol.created_at) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
